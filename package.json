{
  "name": "we-manager",
  "version": "0.9.9",
  "type": "module",
  "description": "Wallpaper Engine workshop manager",
  "desktopName": "we-manager.desktop",
  "author": "UwU <260361707+WallpaperEngineLover@users.noreply.github.com>",
  "email": "260361707+WallpaperEngineLover@users.noreply.github.com",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "electron-store": "^12.0.0",
    "koffi": "^3.3.5",
    "lucide-react": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.we-manager.app",
    "productName": "WE Manager",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "resources/icons/linux",
      "syncDesktopName": true
    },
    "deb": {
      "synopsis": "Wallpaper Engine workshop manager",
      "description": "Browse, organise and apply Wallpaper Engine workshop wallpapers on Linux\nwith the linux-wallpaperengine engine. Handles playlists, per-wallpaper\nsettings, backups and engine updates.",
      "packageCategory": "utils",
      "fpm": [
        "packaging/deb/copyright=/usr/share/doc/we-manager/copyright"
      ],
      "depends": [
        "libc6",
        "libstdc++6",
        "python3",
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "recommends": [
        "libappindicator3-1"
      ]
    },
    "appImage": {
      "artifactName": "WE-Manager-${version}.${ext}"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "!node_modules/steamworks.js/dist/{osx,win64}/**",
      "!node_modules/@koromix/koffi-linux-x64/musl_x64/**",
      "resources/icon.png"
    ],
    "extraResources": [
      {
        "from": "src/main/services/desktop-icons-overlay.py",
        "to": "desktop-icons-overlay.py"
      }
    ],
    "asarUnpack": [
      "resources/icon.png"
    ]
  },
  "homepage": "https://github.com/WallpaperEngineLover/we_manager"
}
