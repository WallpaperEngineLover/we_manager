{
  "name": "we-manager",
  "version": "0.3.0",
  "type": "module",
  "description": "Wallpaper Engine workshop manager",
  "author": "UwU <260361707+WallpaperEngineLover@users.noreply.github.com>",
  "email": "260361707+WallpaperEngineLover@users.noreply.github.com",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "electron-store": "^11.0.2",
    "koffi": "^3.1.2",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.we-manager.app",
    "productName": "WE Manager",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    },
    "appImage": {
      "artifactName": "WE-Manager-${version}.${ext}"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*"
    ]
  }
}
